<%- include('../partials/cabeca') %>
<%
  const dataBR = (s) => s ? s.slice(8, 10) + '/' + s.slice(5, 7) + '/' + s.slice(0, 4) : '—';
  const horaBR = (s) => s ? s.slice(11, 16) : '';
%>
<div class="env env--painel">
  <p class="sim-etiqueta">Ficha do aluno</p>
  <h1><%= aluno.nome %></h1>
  <p class="suave">
    <%= aluno.email %><% if (aluno.instituicao) { %> · <%= aluno.instituicao %><% } %><% if (aluno.serie) { %> · <%= rotuloSerie(aluno.serie) %><% } %>
    · conta criada em <%= dataBR(aluno.criado_em) %>
  </p>

  <% if (recado) { %><p class="aviso aviso--ok"><%= recado %></p><% } %>
  <% if (erro) { %><p class="aviso aviso--erro"><%= erro %></p><% } %>

  <% if (emAberto) { %>
    <p class="aviso">Há um simulado <strong>em andamento</strong> (semana <%= emAberto.semana %>), ainda não concluído. Ele não entra nos números abaixo.</p>
  <% } %>

  <details class="painel ficha-editar">
    <summary>Editar cadastro</summary>

    <form method="post" action="/admin/usuarios/<%= aluno.id %>">
      <div class="campo">
        <label for="nome">Nome completo</label>
        <input type="text" id="nome" name="nome" value="<%= aluno.nome %>" required>
      </div>
      <div class="campo">
        <label for="email">E-mail</label>
        <input type="email" id="email" name="email" value="<%= aluno.email %>" required>
        <p class="dica">É com ele que o aluno entra. Mudar aqui muda o login.</p>
      </div>
      <%
        // Contas antigas podem ter um valor que não está mais na lista ("Escola",
        // "Colégio São José Escolápias"). Ele continua aparecendo como opção
        // selecionada para não sumir sem o professor querer.
        const foraDaLista = (aluno.instituicao || '').trim()
          && !escolas.some((e) => e.sigla === aluno.instituicao);
      %>
      <div class="campo">
        <label for="instituicao">Onde estuda</label>
        <select id="instituicao" name="instituicao">
          <option value=""<%= !(aluno.instituicao || '').trim() ? ' selected' : '' %>>— não informado</option>
          <% escolas.forEach(function (e) { %>
            <option value="<%= e.sigla %>"<%= aluno.instituicao === e.sigla ? ' selected' : '' %>><%= e.sigla === e.nome ? e.sigla : e.sigla + ' — ' + e.nome %></option>
          <% }) %>
          <% if (foraDaLista) { %>
            <option value="<%= aluno.instituicao %>" selected><%= aluno.instituicao %> (cadastro antigo)</option>
          <% } %>
        </select>
        <% if (foraDaLista) { %>
          <p class="dica">Este aluno se cadastrou quando o campo era livre. Escolher uma das opções acima padroniza o filtro.</p>
        <% } %>
      </div>
      <div class="campo">
        <label for="serie">Série</label>
        <select id="serie" name="serie">
          <option value=""<%= !(aluno.serie || '').trim() ? ' selected' : '' %>>— não informada</option>
          <% etapas.forEach(function (et) { %>
            <optgroup label="<%= et.etapa %>">
              <% et.series.forEach(function (s) { %>
                <option value="<%= s.valor %>"<%= aluno.serie === s.valor ? ' selected' : '' %>><%= s.rotulo %></option>
              <% }) %>
            </optgroup>
          <% }) %>
        </select>
      </div>
      <button class="btn" type="submit">Salvar</button>
    </form>

    <hr class="ficha-sep">

    <form method="post" action="/admin/usuarios/<%= aluno.id %>/senha">
      <div class="campo">
        <label for="senha">Definir uma senha nova</label>
        <input type="password" id="senha" name="senha" minlength="8" placeholder="pelo menos 8 caracteres">
        <p class="dica">Para quando o aluno perde a dele. A senha atual é um hash e não pode ser lida — só substituída.</p>
      </div>
      <button class="btn btn--sec" type="submit">Redefinir senha</button>
    </form>

    <hr class="ficha-sep">

    <%# Excluir leva junto simulados e respostas, pelo CASCADE do schema. Por isso
        o e-mail tem de ser digitado, e o servidor confere antes de apagar. %>
    <form method="post" action="/admin/usuarios/<%= aluno.id %>/excluir" class="zona-risco"
          onsubmit="return confirm('Excluir a conta de <%= aluno.nome.replace(/'/g, "\\'") %>? Os simulados e o histórico vão junto, e não há como desfazer.')">
      <h3>Excluir esta conta</h3>
      <p class="dica">
        Apaga o cadastro, os <%= d.vazio ? 0 : d.concluidos %> simulado(s) concluído(s) e todas as respostas.
        <strong>Não tem volta.</strong> Para confirmar, digite o e-mail do aluno.
      </p>
      <div class="campo">
        <label for="confirmacao" class="sr">E-mail do aluno</label>
        <input type="text" id="confirmacao" name="confirmacao" placeholder="<%= aluno.email %>" autocomplete="off">
      </div>
      <button class="btn btn--perigo" type="submit">Excluir permanentemente</button>
    </form>
  </details>

<%# A nota do bimestre vem ANTES do desempenho, e aparece mesmo para quem não
    concluiu simulado nenhum: para o professor, a pergunta "esse aluno vai
    fechar o mínimo?" decide antes de "como ele vai nas questões". É o mesmo
    bloco que o aluno vê em Meu desempenho, redigido na terceira pessoa. %>
<% if (nota) { %>
  <div class="nota-aluno <%= nota.atingiuMinimo ? 'nota-aluno--pronto' : (nota.aindaDaTempo ? '' : 'nota-aluno--risco') %>">
    <div class="nota-aluno__valor">
      <b><%= nota.notaProvisoria == null ? '—' : nota.notaProvisoria.toFixed(1).replace('.', ',') %></b>
      <span>nota provisória</span>
    </div>
    <div class="nota-aluno__corpo">
      <h2>Nota do bimestre</h2>
      <p>
        Fez <strong><%= nota.concluidos %></strong> dos <strong><%= calendario.minimo %></strong>
        simulados obrigatórios (<%= calendario.exigencia %>% de <%= calendario.total %>).
        Nota final hoje:
        <strong class="<%= nota.notaFinal > 0 ? 'nota-ok' : 'nota-zero' %>"><%= nota.notaFinal.toFixed(1).replace('.', ',') %></strong>.
      </p>
      <div class="nota-aluno__prog">
        <span style="width:<%= Math.min(100, Math.round((nota.concluidos / calendario.minimo) * 100)) %>%"></span>
      </div>
      <% if (nota.atingiuMinimo) { %>
        <p>Mínimo cumprido — a nota final é o desempenho dele, e cada simulado novo continua entrando na média.</p>
      <% } else if (!nota.aindaDaTempo) { %>
        <p><strong>Já não é possível alcançar o mínimo:</strong> faltam <%= nota.faltam %> simulados
          e restam <%= nota.semanasRestantes %> semanas. A nota final fica em 0.</p>
      <% } else { %>
        <p>Faltam <strong><%= nota.faltam %></strong> simulados, com
          <strong><%= nota.semanasRestantes %></strong> semanas ainda disponíveis.
          Enquanto não cumprir, a nota final fica <strong>0</strong>.</p>
      <% } %>
      <p><a href="/admin/notas">Ver a turma inteira &rarr;</a></p>
    </div>
  </div>
<% } %>

<%# A mesma sequência que o aluno vê, para o professor não precisar adivinhar
    quem está embalado e quem parou. Aqui é informação, não incentivo: nenhum
    botão, nenhuma comemoração.

    Fora do cartão da nota de propósito — ele é um flex de duas colunas, e um
    terceiro filho entra torto. %>
<% if (nota && (nota.semanasSeguidas.atual > 0 || nota.semanasSeguidas.melhor > 0)) { var q = nota.semanasSeguidas; %>
  <p class="aviso<%= q.atual > 0 && !q.emRisco ? ' aviso--ok' : '' %>">
    <% if (q.atual > 0) { %>
      <strong><%= q.atual %> <%= q.atual === 1 ? 'semana seguida' : 'semanas seguidas' %></strong><% if (q.emRisco) { %> — e ainda não fez a desta semana.<% } else { %> (melhor: <%= q.melhor %>).<% } %>
    <% } else { %>
      Sequência interrompida. A melhor foi de <strong><%= q.melhor %></strong>.
    <% } %>
  </p>
<% } %>

<% if (d.vazio) { %>
  <p class="aviso">Este aluno ainda não concluiu nenhum simulado oficial.</p>
<% } else { %>

  <div class="sim-cartoes">
    <div class="sim-cartao"><span class="sim-cartao__n"><%= d.media %>%</span><span class="sim-cartao__r">média geral</span></div>
    <div class="sim-cartao"><span class="sim-cartao__n"><%= d.concluidos %></span><span class="sim-cartao__r">simulados concluídos</span></div>
    <div class="sim-cartao"><span class="sim-cartao__n"><%= d.acertos %>/<%= d.questoes %></span><span class="sim-cartao__r">acertos</span></div>
    <div class="sim-cartao"><span class="sim-cartao__n"><%= d.melhor.percentual %>%</span><span class="sim-cartao__r">melhor</span></div>
    <div class="sim-cartao"><span class="sim-cartao__n"><%= d.pior.percentual %>%</span><span class="sim-cartao__r">pior</span></div>
    <div class="sim-cartao">
      <span class="sim-cartao__n"><% if (d.variacao === null) { %>—<% } else { %><%= d.variacao > 0 ? '+' : '' %><%= d.variacao %>%<% } %></span>
      <span class="sim-cartao__r">variação no último</span>
    </div>
  </div>

  <% if (d.sequencia.tamanho > 1) { %>
    <p class="aviso <%= d.sequencia.tipo === 'melhora' ? 'aviso--ok' : '' %>">
      Sequência de <strong><%= d.sequencia.tamanho %> simulados</strong> <%= d.sequencia.tipo === 'melhora' ? 'em melhora' : 'em queda' %>.
    </p>
  <% } %>

  <%
    const L = d.simulados;
    const W = 720, H = 240, ml = 42, mr = 16, mt = 18, mb = 32;
    const iw = W - ml - mr, ih = H - mt - mb;
    const px = (i) => ml + (L.length === 1 ? iw / 2 : (i * iw) / (L.length - 1));
    const py = (v) => mt + ih - (v / 100) * ih;
  %>
  <section class="sim-gfx">
    <h2>Evolução</h2>
    <div class="sim-gfx__caixa">
      <svg viewBox="0 0 <%= W %> <%= H %>" role="img" preserveAspectRatio="xMidYMid meet"
           aria-label="Aproveitamento de <%= aluno.nome %> em cada simulado. Média de <%= d.media %>%.">
        <% [0, 50, 100].forEach(function (v) { %>
          <line x1="<%= ml %>" y1="<%= py(v) %>" x2="<%= W - mr %>" y2="<%= py(v) %>" class="gfx-grade"/>
          <text x="<%= ml - 8 %>" y="<%= py(v) + 4 %>" class="gfx-rot" text-anchor="end"><%= v %>%</text>
        <% }) %>
        <line x1="<%= ml %>" y1="<%= py(d.media) %>" x2="<%= W - mr %>" y2="<%= py(d.media) %>" class="gfx-media"/>
        <% if (L.length > 1) { %>
          <polyline points="<%= L.map((s, i) => px(i).toFixed(1) + ',' + py(s.percentual).toFixed(1)).join(' ') %>" class="gfx-linha"/>
        <% } %>
        <% L.forEach(function (s, i) { %>
          <circle cx="<%= px(i) %>" cy="<%= py(s.percentual) %>" r="5" class="gfx-ponto"><title>Simulado <%= s.numero %>: <%= s.percentual %>%</title></circle>
          <text x="<%= px(i) %>" y="<%= H - 10 %>" class="gfx-rot" text-anchor="middle"><%= s.numero %></text>
        <% }) %>
      </svg>
    </div>
  </section>

  <% if (d.porNivel.length || d.porTipo.length) { %>
    <section class="sim-gfx">
      <h2>Onde acerta e onde erra</h2>
      <% [['Por nível CEFR', d.porNivel], ['Por tipo de questão', d.porTipo]].forEach(function (par) { %>
        <% if (par[1].length) { %>
          <h3 class="suave"><%= par[0] %></h3>
          <ul class="gfx-hbarras">
            <% par[1].forEach(function (r) { %>
              <li>
                <span class="gfx-hbarras__rot"><%= r.valor %></span>
                <span class="gfx-hbarras__trilho"><span class="gfx-hbarras__preenche" style="width:<%= r.percentual %>%"></span></span>
                <span class="gfx-hbarras__n"><%= r.percentual %>% <small>(<%= r.acertos %>/<%= r.total %>)</small></span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      <% }) %>
      <p class="dica">Cada recorte só entra a partir de três questões respondidas nele.</p>
    </section>
  <% } %>

  <h2>Simulados, questão por questão</h2>
  <% lista.forEach(function (s) { %>
    <details class="painel">
      <summary>
        <strong><%= dataBR(s.concluido_em) %></strong> · semana <%= s.semana %> ·
        <%= s.acertos %>/<%= s.total %> (<%= Math.round((s.acertos / s.total) * 100) %>%)
        <% if (s.minutos != null) { %> · <%= s.minutos %> min<% } %>
        <% if (!s.gabarito.liberado) { %>
          <span class="etiqueta etiqueta--espera">para o aluno, a correção abre <%= dataBR(s.gabarito.quando) %> às <%= horaBR(s.gabarito.quando) %></span>
        <% } %>
      </summary>
      <div class="tabela-rolagem">
        <table class="tabela">
          <thead><tr><th>#</th><th>Questão</th><th>Prova</th><th>Marcou</th><th>Correta</th><th></th></tr></thead>
          <tbody>
            <% s.itens.forEach(function (q, n) { %>
              <tr>
                <td><%= n + 1 %></td>
                <td><a href="/questoes/<%= q.slug %>" target="_blank" rel="noopener"><%= q.titulo %></a></td>
                <td><%= q.instituicao %><%= q.ano ? ' ' + q.ano : '' %></td>
                <td><strong><%= q.resposta || '—' %></strong></td>
                <td><%= q.gabarito %></td>
                <td class="<%= q.correta ? 'acertou' : 'errou' %>"><%= q.correta ? 'acertou' : 'errou' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </details>
  <% }) %>
<% } %>

  <a class="btn btn--sec" href="/admin/usuarios">Voltar aos alunos</a>
</div>
<%- include('../partials/rodape') %>
