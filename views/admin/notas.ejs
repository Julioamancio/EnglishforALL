<%- include('../partials/cabeca') %>
<div class="env env--painel">
  <h1>Notas por etapa</h1>

  <%- include('../partials/etapas', {
        etapas: etapasDoAno, selecionada: etapaAberta,
        base: '/admin/notas', paraAluno: false }) %>

  <%# A regra por extenso, na tela. Nota de aluno não pode depender de alguém
      lembrar de cabeça qual era o combinado — e agora a régua muda de etapa
      para etapa, o que torna escrevê-la ainda mais necessário. %>
  <div class="aviso aviso--regra">
    <p>
      A <strong><%= calendario.nome %></strong> tem
      <strong><%= calendario.total %> simulados</strong>, um por semana, de
      <strong><%= calendario.primeira %></strong> a <strong><%= calendario.ultima %></strong>.
      O aluno precisa fazer <strong><%= calendario.exigencia %>%</strong> deles, isto é,
      <strong><%= calendario.minimo %> simulados</strong>.
    </p>
    <p>
      A <strong>nota provisória</strong> é o desempenho nos simulados já feitos, de 0 a 10.
      A <strong>nota final</strong> é a mesma nota — mas fica <strong>0</strong> para quem
      não alcançar os <%= calendario.minimo %>, por melhor que tenha ido.
      <% if (!encerrada) { %>Enquanto a etapa não acaba, a coluna final mostra
      como ficaria se ela terminasse hoje.<% } %>
    </p>
  </div>

  <div class="notas-resumo">
    <div class="notas-cartao"><b><%= resumo.alunos %></b><span>alunos</span></div>
    <div class="notas-cartao"><b class="ok"><%= resumo.atingiram %></b><span>já fizeram os <%= calendario.minimo %></span></div>
    <div class="notas-cartao"><b class="alerta"><%= resumo.semNenhum %></b><span>nenhum simulado ainda</span></div>
    <div class="notas-cartao"><b class="<%= resumo.semTempo ? 'perigo' : '' %>"><%= resumo.semTempo %></b><span>já não dá tempo</span></div>
  </div>

  <form class="filtro-alunos" method="get" action="/admin/notas">
    <input type="hidden" name="etapa" value="<%= etapaAberta %>">
    <div class="campo">
      <label for="escola">Instituição</label>
      <select id="escola" name="escola">
        <option value="">Todas (<%= totalGeral %>)</option>
        <% escolas.forEach(function (e) { %>
          <option value="<%= e.chave %>"<%= filtro === e.chave ? ' selected' : '' %>><%= e.nome %> (<%= e.total %>)</option>
        <% }) %>
        <% if (semEscola) { %><option value="sem"<%= filtro === 'sem' ? ' selected' : '' %>>— sem instituição (<%= semEscola %>)</option><% } %>
      </select>
    </div>
    <div class="campo">
      <label for="serie">Série</label>
      <select id="serie" name="serie">
        <option value="">Todas</option>
        <% turmas.forEach(function (t) { %>
          <option value="<%= t.valor %>"<%= turma === t.valor ? ' selected' : '' %>><%= rotuloSerie(t.valor) %> (<%= t.total %>)</option>
        <% }) %>
        <% if (semTurma) { %><option value="sem"<%= turma === 'sem' ? ' selected' : '' %>>— não informada (<%= semTurma %>)</option><% } %>
      </select>
    </div>
    <div class="campo">
      <label for="ordem">Ordenar por</label>
      <select id="ordem" name="ordem">
        <option value="risco"<%= ordem === 'risco' ? ' selected' : '' %>>Quem fez menos simulados</option>
        <option value="nota"<%= ordem === 'nota' ? ' selected' : '' %>>Maior nota provisória</option>
        <option value="az"<%= ordem === 'az' ? ' selected' : '' %>>Nome (A–Z)</option>
      </select>
    </div>
    <div class="filtro-alunos__acoes">
      <button class="btn" type="submit">Filtrar</button>
      <% if (filtro || turma || ordem !== 'risco') { %><a class="btn btn--sec" href="/admin/notas">Limpar</a><% } %>
    </div>
  </form>

  <div class="painel rolagem">
    <% if (!alunos.length) { %>
      <p class="vazio">Nenhum aluno com esse filtro.</p>
    <% } else { %>
      <table class="tabela tabela--larga">
        <thead>
          <tr>
            <th>Aluno</th><th>Onde estuda</th><th>Série</th>
            <%# "Nota provisória" e "Nota final" por extenso custavam 229px de
                cabeçalho numa página que já se chama Nota do bimestre. Encurtar
                foi o que fez a tabela caber sem rolagem lateral. %>
            <th class="num">Simulados</th><th class="num">Média</th>
            <th class="num">Provisória</th><th class="num">Final</th>
            <th>Situação</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% alunos.forEach(function (a) { %>
            <tr>
              <td class="tabela__aluno"><strong><%= a.nome %></strong><br><small class="suave"><%= a.email %></small></td>
              <td><%= a.instituicao || '—' %></td>
              <td class="nao-quebra"><%= a.serie ? rotuloSerie(a.serie) : '—' %></td>
              <td class="num">
                <strong><%= a.concluidos %></strong><span class="suave">/<%= calendario.total %></span>
                <div class="notas-barra" title="<%= a.concluidos %> de <%= calendario.minimo %> exigidos">
                  <span style="width:<%= Math.min(100, Math.round((a.concluidos / calendario.minimo) * 100)) %>%"></span>
                </div>
              </td>
              <td class="num"><%= a.media == null ? '—' : a.media + '%' %></td>
              <td class="num"><strong><%= a.notaProvisoria == null ? '—' : a.notaProvisoria.toFixed(1).replace('.', ',') %></strong></td>
              <td class="num">
                <strong class="<%= a.notaFinal > 0 ? 'nota-ok' : 'nota-zero' %>"><%= a.notaFinal.toFixed(1).replace('.', ',') %></strong>
              </td>
              <td class="nao-quebra">
                <% if (a.atingiuMinimo) { %>
                  <span class="etiqueta etiqueta--ok">mínimo cumprido</span>
                <% } else if (!a.aindaDaTempo) { %>
                  <span class="etiqueta etiqueta--perigo">não dá mais tempo</span>
                <% } else { %>
                  <span class="etiqueta etiqueta--espera">faltam <%= a.faltam %></span>
                  <br><small class="suave"><%= a.semanasRestantes %> semanas restantes</small>
                <% } %>
              </td>
              <td class="tabela__acao"><a href="/admin/usuarios/<%= a.id %>">Ver ficha</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <a class="btn btn--sec" href="/admin">Voltar</a>
</div>
<%- include('../partials/rodape') %>
