<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · English for ALL</title>
<meta name="description" content="<%= description || '' %>">
<link rel="canonical" href="<%= canonical %>">
<link rel="icon" type="image/png" href="/img/favicon.png">
<% if (typeof layoutAdmin !== 'undefined' && layoutAdmin) { %><meta name="robots" content="noindex, nofollow">
<% } else if (typeof comFiltro !== 'undefined' && comFiltro) { %><meta name="robots" content="noindex,follow"><% } %>
<meta property="og:type" content="website">
<meta property="og:site_name" content="English for ALL">
<meta property="og:locale" content="pt_BR">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= description || '' %>">
<meta property="og:url" content="<%= canonical %>">
<meta name="twitter:card" content="summary">
<meta name="theme-color" content="#2f3ab2">
<script>(function(){try{var t=localStorage.getItem('tema');if(t!=='claro'&&t!=='escuro'){t=matchMedia('(prefers-color-scheme: dark)').matches?'escuro':'claro'}document.documentElement.dataset.tema=t}catch(e){document.documentElement.dataset.tema='claro'}})();</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..800&family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/estilo.css?v=54">
<script src="/js/site.js?v=10" defer></script>
<% if (typeof jsonld !== 'undefined' && jsonld) { %>
<script type="application/ld+json"><%- JSON.stringify(jsonld) %></script>
<% } %>
</head>
<body>
<a class="pular" href="#conteudo">Pular para o conteúdo</a>
<header class="topo">
  <%# No painel o cabeçalho acompanha a largura do conteúdo, para a logo nascer na
    mesma borda esquerda dos cards e o último botão terminar na mesma borda
    direita. O login fica de fora: ali o conteúdo é uma coluna estreita, e um
    cabeçalho largo em volta de um formulário pequeno pioraria em vez de
    alinhar. O site público segue nos 1120px de leitura. %>
<% const painelLargo = caminho.startsWith('/admin') && !caminho.startsWith('/admin/login'); %>
<div class="topo__int<%= painelLargo ? ' topo__int--painel' : '' %>">
    <a class="marca" href="/"><img class="marca__logo" src="/img/logo.png?v=2" alt="" width="436" height="512"><span class="marca__nome">English for <em class="marca__all">ALL</em></span></a>
    <button class="nav-abrir" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="nav-principal">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path class="nav-abrir__cima" d="M3 6h18"/><path class="nav-abrir__meio" d="M3 12h18"/><path class="nav-abrir__baixo" d="M3 18h18"/></svg>
    </button>
    <nav class="nav" id="nav-principal" aria-label="Principal">
      <details class="menu menu--nav">
        <summary<%= (caminho.startsWith('/questoes') || caminho.startsWith('/reading') || caminho.startsWith('/use-of-english') || caminho.startsWith('/exercicios') || caminho.startsWith('/medicina')) ? ' class="ativo"' : '' %>>Questões <svg class="menu__seta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
        <ul class="menu__painel menu__painel--largo">
          <li><a href="/reading"><span>Reading</span><span class="menu__n">A1&ndash;C2</span></a></li>
          <li><a href="/use-of-english"><span>Use of English</span><span class="menu__n">A1&ndash;C2</span></a></li>
          <li><a href="/exercicios"><span>Grammar Exercises</span><span class="menu__n"><%= menu.exercicios %></span></a></li>
          <li><a href="/questoes"><span>Questões de ENEM</span><span class="menu__n"><%= menu.todas %></span></a></li>
          <li><a href="/medicina"><span>Questões de Medicina</span><span class="menu__n"><%= menu.medicina %></span></a></li>
        </ul>
      </details>
      <%# "Aprender" e "Simulado" só aparecem para quem entrou. As páginas em si
          continuam públicas — o rodapé mantém o link para o guia de gramática, e
          é por lá que o Google continua chegando. %>
      <% if (logado || usuario) { %>
        <details class="menu menu--nav">
          <summary<%= caminho.startsWith('/gramatica') ? ' class="ativo"' : '' %>>Aprender <svg class="menu__seta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
          <ul class="menu__painel menu__painel--largo">
            <li><a href="/gramatica"><span>Grammar Explanation</span><span class="menu__n">A1&ndash;C2</span></a></li>
          </ul>
        </details>
      <% } %>
      <% if (logado) { %>
        <a href="/prova"<%= caminho.startsWith('/prova') ? ' aria-current="page"' : '' %>>Montar prova</a>
        <a href="/admin"<%= caminho.startsWith('/admin') ? ' aria-current="page"' : '' %>>Painel</a>
      <% } else if (usuario) { %>
        <details class="menu menu--nav">
          <summary<%= caminho.startsWith('/simulado') ? ' class="ativo"' : '' %>>Simulado <svg class="menu__seta" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
          <ul class="menu__painel menu__painel--largo">
            <li><a href="/simulado"><span>Simulado da semana</span><span class="menu__n">5 questões</span></a></li>
            <li><a href="/simulado/historico"><span>Meus simulados</span></a></li>
            <li><a href="/simulado/desempenho"><span>Meu desempenho</span></a></li>
            <li><a href="/simulado/erros"><span>Questões que errei</span></a></li>
          </ul>
        </details>
        <a href="/prova"<%= caminho.startsWith('/prova') ? ' aria-current="page"' : '' %>>Montar prova</a>
        <form class="nav__sair" method="post" action="/sair"><button type="submit" title="Sair da conta (<%= usuario.email %>)">Sair</button></form>
      <% } else { %>
        <a href="/montar-prova"<%= caminho.startsWith('/montar-prova') ? ' aria-current="page"' : '' %>>Montar prova</a>
        <a href="/entrar"<%= (caminho.startsWith('/entrar') || caminho.startsWith('/cadastro')) ? ' aria-current="page"' : '' %>>Entrar</a>
      <% } %>
      <button class="tema-btn" type="button" aria-label="Alternar tema claro/escuro" title="Alternar tema">
        <svg class="icone-lua" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="icone-sol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41"/></svg>
      </button>
    </nav>
  </div>
</header>
<main id="conteudo">
