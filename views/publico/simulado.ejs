<%- include('../partials/cabeca') %>
<%
  // A questão da vez. Se todas estivessem respondidas o servidor já teria
  // concluído o simulado, então aqui sempre há uma pendente.
  const i = atualIndice < 0 ? 0 : atualIndice;
  const q = questoes[i];
%>
<div class="env env--estreito">

  <p class="sim-etiqueta">Simulado oficial · semana <%= simulado.semana %></p>
  <div class="sim-cabeca">
    <h1>Questão <%= i + 1 %> de <%= questoes.length %></h1>
    <%# Cronômetro: conta desde a primeira resposta, com o horário vindo do
        servidor. Só informa o ritmo — não há tempo limite, e o simulado fica
        guardado se o aluno sair no meio. %>
    <% if (simulado.iniciado_em) { %>
      <p class="sim-relogio" data-desde="<%= simulado.iniciado_em.replace(' ', 'T') %>Z" title="Tempo desde a primeira resposta">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        <span>—</span>
      </p>
    <% } %>
  </div>

  <div class="sim-barra" role="img" aria-label="<%= respondidas %> de <%= questoes.length %> questões respondidas">
    <% questoes.forEach(function (item, n) { %>
      <span class="sim-barra__passo<%= item.resposta ? ' feito' : (n === i ? ' agora' : '') %>"></span>
    <% }) %>
  </div>

<%# O que vem antes da primeira questão foi reescrito em 06/08/2026, depois de
    olhar quem abandona.

    Treze alunos abriram e não terminaram, e NOVE não responderam nem a primeira
    questão. Não havia questão travando ninguém — eram treze questões
    diferentes. O que havia era esta tela: a primeira coisa depois do título era
    uma caixa de restrições, terminando em "uma resposta enviada não muda mais".
    Para quem está inseguro, isso é um bom motivo para fechar a aba.

    E o código sabia de uma coisa que a tela nunca disse: o simulado FICA
    GUARDADO. Estava só num comentário aqui dentro. Quem fechou a aba não tinha
    como saber que dava para voltar.

    As regras continuam todas — são pedagógicas, e o aluno precisa saber que a
    resposta é definitiva antes de marcar. O que mudou foi a ordem: primeiro o
    que tranquiliza, depois o que restringe. %>
  <% if (respondidas > 0) { %>
    <p class="retoma">
      <strong>Bem-vindo de volta.</strong>
      Você já respondeu <%= respondidas %> de <%= questoes.length %>
      <%= respondidas === 1 ? 'questão' : 'questões' %>, e continua exatamente de onde parou.
    </p>
  <% } else { %>
    <p class="retoma">
      <strong>Pode ir com calma.</strong>
      São <%= questoes.length %> questões, uns 10 minutos. Se precisar sair no meio,
      o que você já respondeu fica guardado e você volta neste mesmo ponto.
    </p>
  <% } %>

  <p class="aviso">Uma resposta enviada não muda mais, então marque com atenção. O gabarito e o comentário abrem <strong>24 horas depois</strong> que você terminar as <%= questoes.length %>.</p>

  <article class="questao">
    <% if (q.instituicao) { %><p class="origem"><%= q.instituicao %><%= q.ano ? ' · ' + q.ano : '' %></p><% } %>

    <% if (q.imagem) { %>
      <figure class="questao__figura">
        <img src="<%= q.imagem %>" alt="<%= q.imagem_alt || '' %>" loading="lazy">
      </figure>
    <% } %>

    <% if (q.texto_base && q.texto_base.trim()) { %>
      <blockquote class="texto-base">
        <% q.texto_base.trim().split(/\n\s*\n/).forEach(function (p) { %><p><%- realce(p) %></p><% }) %>
      </blockquote>
    <% } %>

    <p class="enunciado"><%- realce(q.enunciado) %></p>

    <form method="post" action="/simulado/responder" class="sim-form">
      <input type="hidden" name="simulado_id" value="<%= simulado.id %>">
      <input type="hidden" name="questao_id" value="<%= q.id %>">
      <ol class="alternativas alternativas--escolha">
        <% q.alternativas.forEach(function (a) { %>
          <li class="alt">
            <label class="sim-alt">
              <input type="radio" name="resposta" value="<%= a.letra %>" required>
              <span class="bolha" aria-hidden="true"><%= a.letra %></span>
              <span><span class="sr"><%= a.letra %>)</span> <%- realce(a.texto) %></span>
            </label>
          </li>
        <% }) %>
      </ol>
      <button class="btn" type="submit">
        <%= i + 1 === questoes.length ? 'Enviar e concluir o simulado' : 'Enviar e ir para a próxima' %>
      </button>
      <p class="dica">Não é possível voltar depois de enviar.</p>
    </form>
  </article>

  <p><a href="/simulado/historico">Meus simulados</a> · <a href="/simulado/desempenho">Meu desempenho</a></p>
</div>
<%- include('../partials/rodape') %>
