<%- include('../partials/cabeca') %>

<section class="hero hero--gram">
  <div class="hero__int">
    <h1>Grammar do <span class="grifo">A1 ao C2</span>, sem mistério</h1>
    <p class="hero__sub">Toda a gramática do inglês explicada em português, nível por nível: diálogos, formação, erros comuns e um mini-teste em cada tópico.</p>

    <div class="turma">
      <figure class="turma__membro">
        <%- include('../partials/persona', { nome: 'sofia', animado: true }) %>
        <figcaption><strong>Teacher Sofia</strong><span>explica a regra</span></figcaption>
      </figure>
      <figure class="turma__membro">
        <%- include('../partials/persona', { nome: 'maya', animado: true }) %>
        <figcaption><strong>Maya</strong><span>pergunta o que você perguntaria</span></figcaption>
      </figure>
      <figure class="turma__membro">
        <%- include('../partials/persona', { nome: 'leo', animado: true }) %>
        <figcaption><strong>Leo</strong><span>dá os macetes</span></figcaption>
      </figure>
      <figure class="turma__membro">
        <%- include('../partials/persona', { nome: 'max', animado: true }) %>
        <figcaption><strong>Max</strong><span>erra para você não errar</span></figcaption>
      </figure>
    </div>
  </div>
</section>

<div class="env">
  <%
    // `busca` só existe quando a rota é /gramatica; a view é reusada em contextos
    // que não passam o termo, daí o typeof.
    var termo = typeof busca !== 'undefined' ? busca : '';
    var achados = typeof encontrados !== 'undefined' ? encontrados : totalTopicos;
  %>

  <form class="gram-busca" method="get" action="/gramatica" role="search">
    <div class="busca">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="search" id="q" name="q" value="<%= termo %>"
             placeholder="Procure um tópico: past simple, conditionals, present perfect…"
             aria-label="Procurar tópico de gramática" autocomplete="off">
      <button class="btn btn--pequeno" type="submit">Buscar</button>
    </div>
    <p class="gram-busca__n" role="status">
      <strong><%= achados %></strong> <span class="gram-busca__rot"><%= achados === 1 ? 'tópico' : 'tópicos' %></span>
      <span class="gram-busca__todos"<%= termo ? '' : ' hidden' %>>· <a href="/gramatica">ver todos os <%= totalTopicos %></a></span>
    </p>
  </form>

  <% if (!niveis.length) { %>
    <p class="vazio">O conteúdo de gramática está sendo preparado. Volte em breve!</p>
  <% } else { %>

  <%# um só estado de "nada encontrado", que serve à busca do servidor e à do
      cliente: o JS só troca o termo e tira o hidden %>
  <p class="vazio gram-vazio"<%= achados ? ' hidden' : '' %>>
    Nenhum tópico para “<span class="gram-vazio__termo"><%= termo %></span>”.
    Tente uma palavra só — <em>past</em>, <em>modal</em>, <em>preposition</em> —
    ou <a href="/gramatica">veja os <%= totalTopicos %> tópicos</a>.
  </p>

  <nav class="niveis-nav" aria-label="Níveis CEFR">
    <% niveis.forEach(function(n){ var casam = typeof n.casam === 'number' ? n.casam : n.topicos.length; %>
      <a class="niveis-nav__pill niveis-nav__pill--<%= n.nivel.toLowerCase() %>" href="#nivel-<%= n.nivel.toLowerCase() %>"<%= casam ? '' : ' hidden' %>>
        <strong><%= n.nivel %></strong> <span><span class="niveis-nav__n"><%= casam %></span> <span class="niveis-nav__rot"><%= casam === 1 ? 'tópico' : 'tópicos' %></span></span>
      </a>
    <% }) %>
  </nav>

  <% niveis.forEach(function(n){ var casam = typeof n.casam === 'number' ? n.casam : n.topicos.length; %>
  <section class="nivel-bloco" id="nivel-<%= n.nivel.toLowerCase() %>" aria-label="Nível <%= n.nivel %>"<%= casam ? '' : ' hidden' %>>
    <div class="nivel-bloco__cabeca">
      <span class="nivel-selo nivel-selo--<%= n.nivel.toLowerCase() %>"><%= n.nivel %></span>
      <div>
        <h2><%= n.titulo %></h2>
        <% if (n.descricao) { %><p><%= n.descricao %></p><% } %>
      </div>
    </div>
    <div class="grade grade--gram">
      <% n.topicos.forEach(function(t, i){ %>
        <%# data-busca: o mesmo texto que o servidor indexa, para o filtro
            instantâneo do site.js achar exatamente o que ?q= acharia %>
        <a class="gcard" href="/gramatica/<%= t.slug %>" data-busca="<%= t.busca %>"<%= t.casa === false ? ' hidden' : '' %>>
          <span class="gcard__num"><%= String(i + 1).padStart(2, '0') %></span>
          <span class="gcard__corpo">
            <strong><%= t.titulo %></strong>
            <% if (t.subtitulo) { %><span class="gcard__sub"><%= t.subtitulo %></span><% } %>
          </span>
          <span class="seta" aria-hidden="true">&rarr;</span>
        </a>
      <% }) %>
    </div>
  </section>
  <% }) %>

  <% } %>
</div>

<%- include('../partials/rodape') %>
