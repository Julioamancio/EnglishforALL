<%- include('../partials/cabeca') %>
<%
  function url(extra) {
    const p = new URLSearchParams();
    const atual = { nivel: filtros.nivel, genero: filtros.genero, q: filtros.busca };
    Object.assign(atual, extra);
    Object.entries(atual).forEach(([k, v]) => { if (v) p.append(k, v); });
    const s = p.toString();
    return s ? col.caminho + '?' + s : col.caminho;
  }
  const temFiltro = Boolean(filtros.nivel || filtros.genero || filtros.busca);
  const [sing, plur] = col.substantivo;
%>
<div class="env">

  <section class="reading-capa">
    <h1><%- col.h1 %></h1>
    <p class="reading-capa__linha"><strong><%= total %></strong> <%= col.chamada %></p>
    <p class="reading-capa__nota">Coleção autoral — separada do banco de questões de provas do ENEM e vestibulares.</p>
  </section>

  <section class="niveis" aria-label="Escolha o nível">
    <% porNivel.forEach(function(n){ %>
      <a class="nivel-card<%= nivel===n.nivel ? ' nivel-card--on' : '' %>" href="<%= url({nivel: nivel===n.nivel ? '' : n.nivel, genero:'', q:''}) %>">
        <span class="nivel-card__topo">
          <span class="nivel-card__sigla"><%= n.nivel %></span>
          <span class="nivel-card__n"><%= n.total %></span>
        </span>
        <span class="nivel-card__desc"><%= n.descricao %></span>
      </a>
    <% }) %>
  </section>

  <form class="reading-filtros" method="get" action="<%= col.caminho %>">
    <% if (nivel) { %><input type="hidden" name="nivel" value="<%= nivel %>"><% } %>
    <div class="campo campo--cresce">
      <label for="q">Buscar nesta coleção</label>
      <input type="search" id="q" name="q" value="<%= filtros.busca || '' %>" placeholder="tema, título ou trecho do texto…">
    </div>
    <div class="campo">
      <label for="genero">Gênero textual</label>
      <select id="genero" name="genero">
        <option value="">Todos os gêneros</option>
        <% facetas.generos.forEach(function(g){ %>
          <option value="<%= g.valor %>"<%= filtros.genero===g.valor?' selected':'' %>><%= rotuloGenero(g.valor) %> — <%= g.total %></option>
        <% }) %>
      </select>
    </div>
    <div class="reading-filtros__acoes">
      <button class="btn" type="submit">Filtrar</button>
      <% if (temFiltro) { %><a class="btn btn--sec" href="<%= col.caminho %>">Limpar</a><% } %>
    </div>
  </form>

  <section aria-live="polite">
    <h2 class="reading-h2">
      <% if (nivel) { %>Nível <%= nivel %><% } else { %>Todos os níveis<% } %>
      <span class="reading-h2__n">
        <%= encontradas %> <%= encontradas === 1 ? sing : plur %><% if (paginas > 1) { %> · página <%= pagina %> de <%= paginas %><% } %>
      </span>
    </h2>

    <% if (!questoes.length) { %>
      <p class="vazio">Nenhum resultado com esses filtros. <a href="<%= col.caminho %>">Ver a coleção inteira</a>.</p>
    <% } else { %>
      <div class="grade">
        <% questoes.forEach(function(q){ %>
          <%- include('../partials/card', { q: q }) %>
        <% }) %>
      </div>

      <% if (paginas > 1) { %>
        <nav class="paginacao" aria-label="Páginas da coleção">
          <% if (pagina > 1) { %>
            <a class="btn btn--sec btn--fino" rel="prev" href="<%= col.caminho %>?<%= qsBase ? qsBase + '&' : '' %>pagina=<%= pagina - 1 %>">← Anterior</a>
          <% } %>
          <span class="paginacao__meio">Página <%= pagina %> de <%= paginas %></span>
          <% if (pagina < paginas) { %>
            <a class="btn btn--sec btn--fino" rel="next" href="<%= col.caminho %>?<%= qsBase ? qsBase + '&' : '' %>pagina=<%= pagina + 1 %>">Próxima →</a>
          <% } %>
        </nav>
      <% } %>
    <% } %>
  </section>

  <section class="painel reading-cta">
    <h2><%= col.ctaTitulo %></h2>
    <p><%= col.ctaTexto %></p>
    <div class="acoes">
      <% if (usuario || logado) { %>
        <a class="btn" href="/prova">Ir para o montador</a>
      <% } else { %>
        <a class="btn" href="/cadastro?voltar=%2Fprova">Criar conta grátis</a>
        <a class="btn btn--sec" href="/entrar?voltar=%2Fprova">Já tenho conta</a>
      <% } %>
    </div>
  </section>

</div>
<%- include('../partials/rodape') %>
