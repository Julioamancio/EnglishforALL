<%- include('../partials/cabeca') %>

<div class="env env--estreito">

  <nav class="migalhas" aria-label="Você está em">
    <a href="/exercicios">Grammar Exercises</a> <span aria-hidden="true">/</span>
    <a href="/exercicios#ex-<%= topico.nivel.toLowerCase() %>">Nível <%= topico.nivel %></a> <span aria-hidden="true">/</span>
    <span><%= topico.titulo %></span>
  </nav>

  <article class="gtopico">
    <header class="gtopico__cabeca">
      <span class="nivel-selo nivel-selo--<%= topico.nivel.toLowerCase() %>"><%= topico.nivel %></span>
      <h1>Teste: <%= topico.titulo %></h1>
      <p class="gtopico__sub"><%= topico.exercicios.length %> questões &middot; clique na alternativa e confira na hora</p>
      <p class="gtopico__resumo">Ficou com dúvida em alguma? A explicação aparece logo abaixo da questão — e a teoria completa está em <a href="/gramatica/<%= topico.slug %>">Grammar Explanation: <%= topico.titulo %></a>.</p>
    </header>

    <%# As dez questões vão inteiras no HTML, sempre. O player só esconde as que
        não são a atual — sem JavaScript esta página continua sendo a lista de
        antes, que funciona e é o que o buscador lê. O painel de progresso e a
        tela de resultado nascem escondidos e só o JavaScript os revela. %>
    <section class="arena" data-arena aria-label="Questões do teste">

      <div class="arena__hud" data-hud hidden>
        <span class="arena__contador">Questão <b data-atual>1</b> de <span data-total><%= topico.exercicios.length %></span></span>
        <span class="arena__trilha" data-trilha aria-hidden="true"></span>
        <span class="arena__placar">
          <%# Cronômetro que conta PARA CIMA: mede quanto o aluno levou nesta
              questão, para ele conhecer o próprio ritmo. Não é contagem
              regressiva, e para no clique — o tempo lendo a explicação é
              estudo, não prova. aria-hidden porque um número que muda a cada
              segundo seria lido em voz alta sem parar; o resumo do tempo vai
              na tela de resultado, aí sim anunciável. %>
          <span class="arena__tempo" data-relogio aria-hidden="true">⏱ <span data-relogio-n>0s</span></span>
          <span class="arena__acertos"><span data-acertos>0</span> ✓</span>
          <span class="arena__seq" data-seq hidden>🔥 <span data-seq-n>0</span></span>
        </span>
      </div>

      <% topico.exercicios.forEach(function(q, qi){ %>
      <div class="quiz" data-correta="<%= q.correta %>">
        <p class="quiz__pergunta"><span class="quiz__n"><%= qi + 1 %></span> <%= q.pergunta %></p>
        <div class="quiz__opcoes">
          <% q.opcoes.forEach(function(op, oi){ %>
            <button type="button" class="quiz__opcao" data-i="<%= oi %>">
              <span class="quiz__forma" aria-hidden="true"></span>
              <span class="quiz__texto"><%= op %></span>
              <span class="quiz__marca" aria-hidden="true"></span>
            </button>
          <% }) %>
        </div>
        <p class="quiz__explica" hidden><%= q.explicacao %></p>
      </div>
      <% }) %>

      <div class="arena__fim" data-fim hidden>
        <p class="arena__nota"><span data-nota>0</span><span>/<%= topico.exercicios.length %></span></p>
        <p class="arena__recado" data-recado></p>
        <div class="arena__barra"><span data-barra></span></div>
        <div class="arena__tempos" data-tempos hidden>
          <span>Tempo total<b data-t-total>—</b></span>
          <span>Média por questão<b data-t-media>—</b></span>
          <span>A mais demorada<b data-t-max>—</b><small data-t-max-q></small></span>
        </div>
        <div class="arena__acoes">
          <button class="btn" type="button" data-refazer>Refazer o teste</button>
          <a class="btn btn--sec" href="/gramatica/<%= topico.slug %>">Ver a explicação do tópico</a>
        </div>
        <div class="arena__revisao" data-revisao hidden>
          <h3>O que revisar</h3>
          <ol data-revisao-lista></ol>
        </div>
      </div>

    </section>

    <nav class="gnav" aria-label="Outros testes do nível">
      <% if (vizinhos.anterior && (vizinhos.anterior.exercicios || []).length) { %>
        <a class="gnav__lado" href="/exercicios/<%= vizinhos.anterior.slug %>"><span>&larr; Teste anterior</span><strong><%= vizinhos.anterior.titulo %></strong></a>
      <% } else { %><span></span><% } %>
      <% if (vizinhos.proximo && (vizinhos.proximo.exercicios || []).length) { %>
        <a class="gnav__lado gnav__lado--dir" href="/exercicios/<%= vizinhos.proximo.slug %>"><span>Próximo teste &rarr;</span><strong><%= vizinhos.proximo.titulo %></strong></a>
      <% } %>
    </nav>

    <p class="gtopico__cta">Quer o contexto completo? <a href="/gramatica/<%= topico.slug %>">Leia a explicação de <%= topico.titulo %> com a Teacher Sofia &rarr;</a></p>
  </article>
</div>

<%- include('../partials/rodape') %>
