# Porta interna do Node. O nginx faz proxy para cá.
PORT=8098

# Endereço público — usado em canonical, sitemap e Open Graph.
SITE_URL="https://ingles.destruitor.com.br"

# Segredo do cookie de sessão. Gere um valor aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Hash da senha do painel. Gere com:
#   npm run senha "sua senha"
ADMIN_SENHA_HASH=""

# Caminho do banco SQLite.
DB_PATH="./dados/banco.db"

NODE_ENV=production

# Caminho do banco de sessões (separado do acervo).
SESSIONS_PATH="./dados/sessoes.db"

# ------------------------------------------------------------------ e-mail
# Usado pelo aviso semanal (scripts/aviso-semanal.js). Sem isto o script se
# recusa a enviar em vez de falhar no meio do lote.
#
# Gmail: a senha NÃO é a da conta. É uma "senha de app" de 16 letras, gerada em
# myaccount.google.com/apppasswords (exige verificação em duas etapas ligada).
# Ela só serve para SMTP e pode ser revogada sozinha, sem trocar a senha real.
SMTP_USER=""
SMTP_SENHA=""
# Opcionais — os padrões abaixo já servem para o Gmail.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORTA=465
# SMTP_NOME="English for ALL"
